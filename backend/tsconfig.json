{
  "compilerOptions": {
    "target": "ES2022", "lib": ["esnext"], "skipLibCheck": true, "strict": true, "noEmit": true,
    "esModuleInterop": true, "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "worker/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
