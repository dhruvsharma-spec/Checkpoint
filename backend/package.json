{
  "name": "checkpoint-backend",
  "version": "0.3.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx --env-file=.env worker/index.ts",
    "build": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:new-migration": "prisma migrate dev --create-only",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "^4.21.1",
    "google-auth-library": "^9.14.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.15",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
