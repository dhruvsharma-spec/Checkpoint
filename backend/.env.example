# Copy to .env for running the backend outside Kubernetes (npm run dev). On minikube these come from deploy/k8s.
# The frontend has its own settings, see frontend/.env.example.

# local = developer conveniences (dev sign-in buttons, plain-http cookies). Anything else behaves as production.
APP_ENV=local
DATABASE_URL=mysql://checkpoint:checkpoint@localhost:3306/checkpoint
# The address people open in the browser (the frontend). Emails link here and Google redirects back here.
WEB_URL=http://localhost:3000
PORT=4000

# Sessions. Generate one:  openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me
SESSION_HOURS=8

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=lenskart.com,lenskart.in
# Comma-separated emails that become Admin on first sign-in
BOOTSTRAP_ADMINS=
DEV_LOGIN=true
COOKIE_SECURE=

# Email. Local: Mailpit. Production: the SES SMTP endpoint, with SMTP_TLS=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
MAIL_FROM=Checkpoint <checkpoint@lenskart.com>

# Loads a dozen varied sample CCBs once, so the screens have something to show
SEED_SAMPLES=true

# Which kinds of CCB can be filed: general only for now. A comma-separated list of keys, or "all".
ENABLED_CCB_TYPES=general
